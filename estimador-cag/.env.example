# Proveedor primario (por defecto anthropic)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001

# Proveedor de respaldo: se usa solo si el primario falla.
# Deja ambos vacíos para desactivar el fallback.
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

APP_ENV=development
LOG_LEVEL=DEBUG
